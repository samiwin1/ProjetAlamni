{% extends 'base_front.html.twig' %}

{% block title %}Messages - Message #{{ message.id }}{% endblock %}
{% block hero %}{% endblock %}
{% block call_to_action %}{% endblock %}
{% block appointment %}{% endblock %}
{% block testimonial %}{% endblock %}
{% block team %}{% endblock %}
{% block classes %}{% endblock %}
{% block about %}{% endblock %}

{% block content %}
<div class="container-xxl py-5 page-header position-relative mb-5">
    <div class="container py-5">
        <h1 class="display-4 text-white animated slideInDown">Messages</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb bg-transparent p-0">
                <li class="breadcrumb-item">
                    <a href="{{ path('app_home') }}" class="text-white">Accueil</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="{{ path('app_message_index') }}" class="text-white">Messages</a>
                </li>
                <li class="breadcrumb-item active text-white" aria-current="page">Message #{{ message.id }}</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded">
                <div class="card-body p-4">
                    <h2 class="card-title text-primary">Message #{{ message.id }}</h2>
                     
        <p>
            <strong>{{ message.content }}</strong><br>
            <a href="{{ path('app_reponse_new', { 'id': message.id }) }}" class="btn btn-primary">Répondre</a>
        </p>
    
                </div>
            </div>
            <div class="mt-4 text-center">
                <a href="{{ path('app_message_index') }}" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left"></i> Retour à la liste
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
