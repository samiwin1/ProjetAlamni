{% extends 'base_front.html.twig' %}

{% block title %}Répondre au Message{% endblock %}
{% block hero %}{% endblock %}
{% block call_to_action %}{% endblock %}
{% block appointment %}{% endblock %}
{% block testimonial %}{% endblock %}
{% block team %}{% endblock %}
{% block classes %}{% endblock %}
{% block about %}{% endblock %}

{% block content %}
<div class="container-xxl py-5 page-header position-relative mb-5">
    <div class="container py-5">
        <h1 class="display-2 text-white animated slideInDown mb-4">Répondre au message</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-white">🏠 Accueil</a></li>
                <li class="breadcrumb-item"><a href="#" class="text-white">📜 Pages</a></li>
                <li class="breadcrumb-item text-white active" aria-current="page">✉️ Réponses</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Formulaire de réponse -->
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center rounded-top">
                    <h3 class="fw-bold mb-0">Modifier Reponse</h3>
                </div>
                <div class="card-body p-4">
                    <h4 class="mb-4">Message : {{reponse.content }}</h4>

                    <!-- Formulaire -->
                    {{ form_start(form, {'attr': {'class': 'form-response'}}) }}
                        <div class="mb-3">
                            {{ form_row(form.content, {'attr': {'class': 'form-control p-3 rounded-3', 'placeholder': 'Votre réponse...'}}) }}
                        </div>
                        <div class="d-flex justify-content-between">
                            <button class="btn btn-success">Envoyer la réponse</button>
                            <a href="{{ path('app_reponse_index') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left"></i> Retour à la liste
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block stylesheets %}
<style>
    .form-control {
        font-size: 1rem;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        border-color: #007bff;
        box-shadow: 0 0 8px rgba(0, 123, 255, 0.25);
    }

    .btn {
        font-size: 1rem;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .btn-outline-secondary {
        border-color: #6c757d;
        color: #6c757d;
    }

    .btn-outline-secondary:hover {
        background-color: #f8f9fa;
    }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }

    .btn-success:hover {
        background-color: #218838;
        border-color: #1e7e34;
    }
    
    .card-header {
        background-color: #007bff;
        color: white;
        font-size: 1.5rem;
    }

    .card-body {
        background-color: #f8f9fa;
    }

    .breadcrumb-item a {
        color: #007bff;
    }

    .breadcrumb-item.active {
        color: #343a40;
    }

    .page-header {
        background-color: #007bff;
        border-radius: 8px;
    }
</style>
{% endblock %}