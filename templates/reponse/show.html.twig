{% extends 'base_front.html.twig' %}

{% block title %}Réponse - Message #{{ reponse.id }}{% endblock %}

{% block content %}
<div class="container-xxl py-5 page-header position-relative mb-5">
    <div class="container py-5">
        <h1 class="display-2 text-white animated slideInDown mb-4">Répondre au message</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-white">🏠 Accueil</a></li>
                <li class="breadcrumb-item"><a href="#" class="text-white">📜 Pages</a></li>
                <li class="breadcrumb-item text-white active" aria-current="page">✉️ Réponse</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Affichage du message original -->
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center rounded-top">
                    <h3 class="fw-bold mb-0">Détails du message</h3>
                </div>
                <div class="card-body p-4">
                    <!-- Affichage du message original -->
                    <div class="mb-4">
                        <p><strong>Message :</strong> {{ message.content }}</p>
                    </div>

                    <!-- Affichage de la réponse -->
                    <div class="mb-4">
                        <p><strong>Réponse :</strong> {{ reponse.content }}</p>
                    </div>
<p>
            <strong>{{ message.content }}</strong><br>
            <a href="{{ path('app_reponse_new', { 'id': message.id }) }}" class="btn btn-primary">Répondre</a>
        </p>
                    <!-- Boutons -->
                    <a href="{{ path('app_reponse_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Retour à la liste
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
