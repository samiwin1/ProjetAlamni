{% extends 'front.html.twig' %}

{% block title %}Alamni - Plateforme éducative{% endblock %}

{% block css %}
    {{ parent() }}
    <style>
        .carousel-item {
            height: 300px;
            background-size: cover;
            background-position: center;
        }
        #map {
            height: 400px;
            width: 100%;
        }
    </style>
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
{% endblock %}

{% block navbar %}
    {{ parent() }}
{% endblock %}

{% block hero %}
    <div class="container-fluid p-0 mb-5">
        <div class="owl-carousel header-carousel position-relative">
            <div class="owl-carousel-item position-relative">
                <img class="img-fluid" src="{{ asset('img/carousel-1.jpg') }}" alt="Image carousel principale">
                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center" style="background: rgba(0, 0, 0, .2);">
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-10 col-lg-8">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="container-xxl py-5">
        <div class="container">
            <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
                <h1 class="mb-3">Nos événements</h1>
                <p>L’apprentissage ne s’arrête jamais : rejoignez nos événements ! </p>
            </div>
            
            <!-- Event Cards Section -->
            <div class="row g-4 mt-4">
                {% if events is empty %}
                    <div class="col-12 text-center">
                        <p>Aucun événement n'est disponible pour le moment.</p>
                    </div>
                {% else %}
                    {% for event in events %}
                    <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="position-relative overflow-hidden">
                                <img class="img-fluid w-100" src="{{ asset(event.image) }}" alt="{{ event.nom }}">
                            </div>
                            <div class="card-body text-center p-4">
                                <h5 class="card-title mb-3">{{ event.nom }}</h5>
                                <p class="card-text mb-3">{{ event.description|length > 100 ? event.description|slice(0, 100) ~ '...' : event.description }}</p>
                                <div class="d-flex justify-content-between mb-3">
                                    <div class="text-start">
                                        <p class="mb-2"><i class="far fa-calendar-alt text-primary me-2"></i>{{ event.date|date('d/m/Y') }}</p>
                                        <p class="mb-2"><i class="far fa-clock text-primary me-2"></i>{{ event.heureDebut|date('H:i') }} - {{ event.heureFin|date('H:i') }}</p>
                                        <p class="mb-0"><i class="fas fa-map-marker-alt text-primary me-2"></i>{{ event.lieu }}</p>
                                    </div>
                                </div>
                                <a href="{{ path('event_details', {'id': event.id}) }}" class="btn btn-primary">More</a>
                                <button class="btn btn-outline-secondary favorite-btn" data-event-id="{{ event.id }}">
                                    <i class="fas fa-star"></i>
                                </button>
                                <div class="mt-2">
                                    <i class="fas fa-user"></i> {{ event.favorites|length }} favorites
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                {% endif %}
            </div>

            <!-- Map Section - Moved Under the Events -->
            <div id="map"></div>
        </div>
    </div>

<!-- JavaScript Libraries -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ asset('lib/wow/wow.min.js') }}"></script>
<script src="{{ asset('lib/owlcarousel/owl.carousel.min.js') }}"></script>
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<!-- Template Javascript -->
<script src="{{ asset('js/main.js') }}"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const favoriteButtons = document.querySelectorAll('.favorite-btn');

    favoriteButtons.forEach(button => {
        button.addEventListener('click', function() {
            const eventId = this.getAttribute('data-event-id');
            fetch(`/event/${eventId}/favorite`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': '{{ csrf_token('favorite') }}'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.message) {
                    alert(data.message);
                    location.reload();
                } else if (data.error) {
                    alert(data.error);
                }
            });
        });
    });

    // Initialize the map
    const map = L.map('map').setView([36.8065, 10.1815], 13); // Default coordinates (Tunis)

    // Add OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    // Add markers for each event
    {% for event in events %}
        L.marker([{{ event.latitude }}, {{ event.longitude }}]).addTo(map)
            .bindPopup('<b>{{ event.nom }}</b><br>{{ event.lieu }}');
    {% endfor %}

    // Function to get current location
    function getCurrentLocation() {
        if ("geolocation" in navigator) {
            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const lat = position.coords.latitude;
                    const lon = position.coords.longitude;
                    console.log("Latitude: ", lat);
                    console.log("Longitude: ", lon);

                    // Add a person icon for the current location
                    const personIcon = L.icon({
                        iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-icon-red.png',
                        iconSize: [25, 41],
                        iconAnchor: [12, 41],
                        popupAnchor: [1, -34],
                        shadowSize: [41, 41]
                    });

                    L.marker([lat, lon], { icon: personIcon }).addTo(map)
                        .bindPopup('<b>Vous êtes ici</b>')
                        .openPopup();

                    // Center the map on the current location
                    map.setView([lat, lon], 13);
                },
                (error) => {
                    console.error("Error getting current location: ", error.message);
                }
            );
        } else {
            console.log("Geolocation is not supported by this browser.");
        }
    }

    // Call the function to get current location
    getCurrentLocation();
});
</script>
{% endblock %}
