{# templates/frontOffice/facility.html.twig #}

{% extends 'base_front.html.twig' %}

{% block content %}
    <div class="container">
        <h1>School Agenda</h1>
        {% if 'ROLE_TEACHER' in user.roles %}
            <p>Welcome, Teacher {{ user.getNom() }} {{ user.getPrenom() }}!</p>
        {% elseif 'ROLE_STUDENT' in user.roles %}
            <p>Welcome, Student {{ user.getNom() }} {{ user.getPrenom() }}!</p>
        {% endif %}
        <div id="calendar"></div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                themeSystem: 'bootstrap',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                events: [
                    {% for plan in planning %}
                        {
                            title: '{{ plan.name }}',
                            start: '{{ plan.startTime|date('Y-m-d\\TH:i:s') }}',
                            end: '{{ plan.endTime|date('Y-m-d\\TH:i:s') }}',
                            description: '{{ plan.seance ? plan.seance.name : 'No seance' }}',
                            teacher: '{{ plan.teacher ? plan.teacher.getNom() ~ ' ' ~ plan.teacher.getPrenom() : 'No Teacher' }}',
                            level: '{{ plan.studentLevel ? plan.studentLevel : 'No Level' }}',
                            color: '#007bff',
                            textColor: '#fff'
                        },
                    {% endfor %}
                ],
                eventClick: function(info) {
                    var eventObj = info.event;
                    alert(
                        "Séance: " + eventObj.extendedProps.description + "\n" +
                        "Enseignant: " + eventObj.extendedProps.teacher + "\n" +
                        "Niveau: " + eventObj.extendedProps.level
                    );
                }
            });
            calendar.render();
        });
    </script>
{% endblock %}