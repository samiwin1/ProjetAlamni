{% extends 'base_front.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="row">
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-body text-center">
                    {% if user.photo %}
                        <img src="data:image/jpeg;base64,{{ user.photo }}" 
                             alt="avatar" class="rounded-circle img-fluid" 
                             style="width: 150px; height: 150px; object-fit: cover;">
                    {% else %}
                        <img src="{{ asset('images/default-avatar.png') }}" 
                             alt="avatar" class="rounded-circle img-fluid" 
                             style="width: 150px;">
                    {% endif %}
                    <h5 class="my-3">{{ user.nom }}</h5>
                    <p class="text-muted mb-1">{{ user.role }}</p>
                    <div class="d-flex justify-content-center mb-2">
                        <a href="{{ path('front_profile_edit') }}" class="btn btn-primary">Modifier le profil</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-3">
                            <p class="mb-0">Nom</p>
                        </div>
                        <div class="col-sm-9">
                            <p class="text-muted mb-0">{{ user.nom }}</p>
                        </div>
                    </div>
                    <hr>
                    <div class="row">
                        <div class="col-sm-3">
                            <p class="mb-0">Email</p>
                        </div>
                        <div class="col-sm-9">
                            <p class="text-muted mb-0">{{ user.email }}</p>
                        </div>
                    </div>
                    <hr>
                    <div class="row">
                        <div class="col-sm-3">
                            <p class="mb-0">Date d'inscription</p>
                        </div>
                        <div class="col-sm-9">
                            <p class="text-muted mb-0">{{ user.dateInscription|date('d/m/Y') }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}