{% extends 'base_front.html.twig' %}

{% block hero %}{% endblock %}
{% block call_to_action %}{% endblock %}
{% block appointment %}{% endblock %}
{% block testimonial %}{% endblock %}
{% block classes %}{% endblock %}
{% block about %}{% endblock %}
{% block team %}{% endblock %}


{% block content %}
<div class="container py-5">
    <h1 class="text-primary text-center">Mes Réclamations</h1>

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger text-center">
            {{ message }}
        </div>
    {% endfor %}

    <div class="d-flex justify-content-end mb-3">
        <label for="statusFilter" class="me-2 fw-bold">Filtrer par statut :</label>
        <select id="statusFilter" class="form-select w-auto">
            <option value="">Tous</option>
            <option value="En attente">En attente</option>
            <option value="En cours">En cours</option>
            <option value="Résolue">Résolue</option>
        </select>
    </div>

    {% if reclamations is empty %}
        <p class="text-center">Aucune réclamation envoyée pour l'instant.</p>
    {% else %}
        <table class="table table-bordered mt-4">
            <thead>
                <tr>
                    <th>Objet</th>
                    <th>Description</th>
                    <th>Date</th>
                    <th>Statut</th>
                    <th>Réponse</th>
                </tr>
            </thead>
            <tbody>
                {% for reclamation in reclamations %}
                    <tr>
                        <td>
                            {{ reclamation.objet }}
                            {% if unreadResponsesCounts[reclamation.id] > 0 %}
                                <span class="badge bg-danger ms-2">
                                    {{ unreadResponsesCounts[reclamation.id] }} 
                                    {% if unreadResponsesCounts[reclamation.id] > 1 %}Nouvelles réponses{% else %}Nouvelle réponse{% endif %}
                                </span>
                            {% endif %}
                        </td>
                        <td>{{ reclamation.description }}</td>
                        <td>{{ reclamation.dateSoumission|date('d/m/Y H:i') }}</td>
                        <td>
                            {% if reclamation.status == 'En attente' %}
                                <span class="badge bg-warning text-dark">{{ reclamation.status }}</span>
                            {% elseif reclamation.status == 'En cours' %}
                                <span class="badge bg-primary text-white">{{ reclamation.status }}</span>
                            {% elseif reclamation.status == 'Résolue' %}
                                <span class="badge bg-success text-white">{{ reclamation.status }}</span>
                            {% else %}
                                <span class="badge bg-secondary text-white">{{ reclamation.status }}</span>
                            {% endif %}
                        </td>

                        <td>
                            {% if reclamation.reponses|length > 0 %}
                                <a href="{{ path('app_reponsereclamation_show', {'id': reclamation.reponses|first.id}) }}" class="btn btn-primary btn-sm">
                                    <i class="fas fa-envelope"></i> Voir la réponse
                                </a>
                            {% else %}
                                <span class="badge bg-secondary">Aucune réponse</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>

        </table>
    {% endif %}
</div>

<script>
    document.getElementById("statusFilter").addEventListener("change", function () {
        let selectedStatus = this.value.toLowerCase();
        let rows = document.querySelectorAll("tbody tr");

        rows.forEach(row => {
            let statusText = row.querySelector("td:nth-child(4)").textContent.toLowerCase(); // Statut de la réclamation
            
            // Si aucun filtre sélectionné ou le statut correspond, afficher la ligne
            if (selectedStatus === "" || statusText.includes(selectedStatus)) {
                row.style.display = "";
            } else {
                row.style.display = "none"; // Masquer les autres lignes
            }
        });
    });
</script>


{% endblock %}
