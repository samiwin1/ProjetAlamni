<!DOCTYPE html>

<title>Hello FavoriteController!</title>

{% block body %}{% extends 'base_front.html.twig' %}

{% block title %}Mes Conversations Favorites{% endblock %}

{% block content %}
    <h2>⭐ Mes Conversations Favorites</h2>
    <ul>
        {% for favorite in favorites %}
            <li>
                <a href="{{ path('app_message_show', {id: favorite.conversation.id}) }}">
                    {{ favorite.conversation.user1.nom }} & {{ favorite.conversation.user2.nom }}
                </a>
            </li>
        {% else %}
            <p>Aucune conversation favorite.</p>
        {% endfor %}
    </ul>
{% endblock %}

<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {{ controller_name }}! ✅</h1>

    This friendly message is coming from:
    <ul>
        <li>Your controller at <code>D:/ProjetAlamni-Conversation-Roua/src/Controller/FavoriteController.php</code></li>
        <li>Your template at <code>D:/ProjetAlamni-Conversation-Roua/templates/favorite/index.html.twig</code></li>
    </ul>
</div>
{% endblock %}
