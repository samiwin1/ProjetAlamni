{% extends 'base_front.html.twig' %}

{% block hero %}{% endblock %}
{% block call_to_action %}{% endblock %}
{% block appointment %}{% endblock %}
{% block testimonial %}{% endblock %}
{% block classes %}{% endblock %}
{% block about %}{% endblock %}
{% block team %}{% endblock %}

{% block title %}Détails de la Réclamation{% endblock %}

{% block content %}
<div class="container mt-5">
 <div class="card p-4 shadow">
    <h1>Réclamation</h1>
    <p><strong>Objet :</strong> {{ reclamation.objet }}</p>
    <p><strong>Description :</strong> {{ reclamation.description }}</p>
    <p><strong>Status :</strong> {{ reclamation.status }}</p>

    {% if app.user and app.user.role == 'ROLE_ADMIN' %}
        <a href="{{ path('app_reponsereclamation_new', {'reclamationId': reclamation.id}) }}" class="btn btn-success">
            Répondre
        </a>
    {% endif %}

<h2>Réponses</h2>

{% if reclamation.reponses is not empty %}
    {% for reponse in reclamation.reponses %}
        <div class="card mt-3">
            <div class="card-body">
                <p><strong>Admin:</strong> {{ reponse.admin.nom }} {{ reponse.admin.prenom }}</p>
                <p>{{ reponse.contenue }}</p>
                <small class="text-muted">Posté le {{ reponse.dateReponse|date('d/m/Y H:i') }}</small>
            </div>
        </div>
    {% endfor %}
{% else %}
    <p>Aucune réponse disponible.</p>
{% endif %}
        <!-- ✅ Bouton Retourner -->
        <div class="mt-4">
            <a href="{{ path('app_my_reclamations') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retourner
            </a>
        </div>
 </div>
  </div>

{% endblock %}
