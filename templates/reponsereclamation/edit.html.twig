{% extends 'base_front.html.twig' %}

{% block title %}Éditer la Réclamation{% endblock %}

{% block hero %}{% endblock %}
{% block call_to_action %}{% endblock %}
{% block appointment %}{% endblock %}
{% block testimonial %}{% endblock %}
{% block classes %}{% endblock %}
{% block about %}{% endblock %}
{% block team %}{% endblock %}

{% block content %}
    <div class="container mt-5">
        <h1 class="text-primary text-center">Éditer la Réclamation</h1>

        <div class="card p-4 shadow">
            <h2 class="mb-4">Modifier la réponse</h2>

            {{ include('reponsereclamation/_form.html.twig') }}

            <!-- Boutons Retour, Mettre à jour et Supprimer -->
            <div class="mt-4 d-flex justify-content-center gap-3">
                <!-- Bouton Retour -->
                <a href="{{ path('app_reponsereclamation_new', {'reclamationId': reponsereclamation.reclamation.id}) }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>

                <!-- Bouton Mettre à jour -->
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Mettre à jour
                </button>

                <!-- Bouton Supprimer -->
                <form method="post" action="{{ path('app_reponsereclamation_new', {'reclamationId': reponsereclamation.reclamation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette réponse ?');">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt"></i> Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
