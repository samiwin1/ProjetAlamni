{% extends 'base_front.html.twig' %}

{% block title %}Répondre à la Réclamation{% endblock %}

{% block hero %}{% endblock %}
{% block call_to_action %}{% endblock %}
{% block appointment %}{% endblock %}
{% block testimonial %}{% endblock %}
{% block classes %}{% endblock %}
{% block about %}{% endblock %}
{% block team %}{% endblock %}

{% block content %}
  <div class="container mt-5">
    <h1 class="text-primary text-center mb-4">Répondre à la Réclamation</h1>

    <div class="card p-4 shadow">
        <p><strong>Réclamation de :</strong> {{ reclamation.userEmail }}</p>
        <p><strong>Objet :</strong> {{ reclamation.objet }}</p>
        <p><strong>Description :</strong> {{ reclamation.description }}</p>

        {{ form_start(form) }}
            <div class="form-group mb-3">
                {{ form_label(form.contenue) }}
                {{ form_widget(form.contenue, {'attr': {'class': 'form-control'}}) }}
            </div>
            <button class="btn btn-primary">Envoyer</button>
        {{ form_end(form) }}
    </div>

    <!-- 🔹 Affichage des réponses avec actions Admin -->
    <div class="mt-5">
        <h2 class="text-secondary">Réponses précédentes</h2>

            {% if reclamation.reponses is not empty %}
        {% for reponse in reclamation.reponses %}
            <div class="card mt-3 p-3">
                <p><strong>Admin :</strong> {{ reponse.admin.nom }} {{ reponse.admin.prenom }}</p>
                <p>{{ reponse.contenue }}</p>
                <small class="text-muted">Posté le {{ reponse.dateReponse|date('d/m/Y H:i') }}</small>

                <div class="mt-2">
                    <a href="{{ path('app_reponsereclamation_edit', {'id': reponse.id}) }}" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i> Modifier
                    </a>

                    <form method="post" action="{{ path('app_reponsereclamation_delete', {'id': reponse.id}) }}" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reponse.id) }}">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette réponse ?');">
                            <i class="fas fa-trash-alt"></i> Supprimer
                        </button>
                    </form>
                </div>
            </div>
        {% endfor %}
        {% else %}
            <p class="text-muted">Aucune réponse pour cette réclamation.</p>
        {% endif %}
    </div>

    <div class="text-center">
        <a href="{{ path('app_reclamation_front_show', {'id': reclamation.id}) }}" class="btn btn-secondary mt-4">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
    </div>

  </div>
{% endblock %}
