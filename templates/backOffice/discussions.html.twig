{% extends 'base_back.html.twig' %}

{% block title %}discussions {% endblock %}

{% block navbar %}{% endblock %}
{% block sidebar %}{% endblock %}

{% block preloader %}{% endblock %}
{% block main %}{% endblock %}


{% block welc %}


<div class="container-fluid d-flex flex-column flex-lg-row gap-4 p-4">
    <!-- Sidebar -->
    <nav class="sidebar bg-white p-4 rounded-4 shadow-sm">
        <h4 class="mb-4 fw-bold text-primary">Dossiers</h4>
        <ul class="list-unstyled">
            <li>
                <a href="{{ path('app_reponse_index') }}" class="d-flex align-items-center text-dark py-2 text-decoration-none hover-bg-light rounded-3">
                    <i class="fas fa-inbox me-2 text-primary"></i> Boîte de réception 
                </a>
            </li>
            <li>
                <a href="{{ path('app_message_index') }}"  class="d-flex align-items-center text-dark py-2 text-decoration-none hover-bg-light rounded-3">
                    <i class="fas fa-paper-plane me-2 text-primary"></i> Éléments envoyés 
                </a>
            </li>
            <li>
                <a href="#" class="d-flex align-items-center text-dark py-2 text-decoration-none hover-bg-light rounded-3">
                    <i class="fas fa-file-alt me-2 text-primary"></i> Brouillons
                </a>
            </li>
            <li>
                <a href="#" class="d-flex align-items-center text-dark py-2 text-decoration-none hover-bg-light rounded-3">
                    <i class="fas fa-trash me-2 text-danger"></i> Éléments supprimés
                </a>
            </li>
        </ul>
    </nav>

    <!-- Table Content -->
    <div class="content w-100">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold">Liste des Messages</h2>
            <a href="{{ path('app_message_new') }}" class="btn btn-primary"><i class="fas fa-plus"></i> Nouveau Message</a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover shadow-sm rounded">
                <thead class="bg-primary text-white">
                    <tr>
                        <th>ID</th>
                        <th>Contenu</th>
                        <th>Date de création</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for message in messages %}
                        <tr class="post-item">
                            <td>{{ message.id }}</td>
                            <td>{{ message.content }}</td>
                            <td>{{ message.createdAt|date('d/m/Y H:i') }}</td>
                            <td>
                                <div class="action-buttons d-flex gap-2">
                                    <a href="{{ path('discussionsedit', {id: message.id}) }}" class="btn btn-warning btn-sm btn-icon" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="{{ path('app_message_show', {id: message.id}) }}" class="btn btn-danger btn-sm btn-icon" title="show"
                                       >
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted">Aucune publication trouvée.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}