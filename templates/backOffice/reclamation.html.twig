{% extends 'base_back.html.twig' %}


{% block stylesheets %}
<style>
.table {
    margin-top: 5px;
    border-collapse: collapse;
    width: 100%;
}

.table th, .table td {
    padding: 5px;
    text-align: center;
    border: 0.01px solid #ddd;
}

.table th {
    background-color: #343a40;
    color: white;
}

.table tbody tr:nth-child(even) {
    background-color: #f9f9f9;
}

.table tbody tr:hover {
    background-color: #e0e0e0;
}

.actions {
    display: flex;
    gap: 5px;
    justify-content: center;
    align-items: center;
}

.delete-form {
    display: inline;
}

.search-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
}

.search-container input, .search-container select {
    width: 48%;
    padding: 8px;
    font-size: 14px;
    border-radius: 5px;
    border: 1px solid #ccc;
}

</style>
{% endblock %}

{% block title %}Reclamations{% endblock %}
{% block navbar %}{% endblock %}
{% block welc %}

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>



    <h1 class="my-3 text-center" style="font-size: 32px;">Liste des Réclamations</h1>

    <!-- 🏷️ Checkbox pour le tri par date -->
        <div class="form-check">
            <label>
                <input type="checkbox" id="sortByDate" onchange="sortTableByDate()">
                Trier par date (du plus récent au plus ancien)
            </label>
        </div>



    <!-- 🔎 Zone de recherche et de filtrage -->
    <div class="search-container" style="margin-bottom: 15px; padding: 10px;">
        <!-- 🔎 Barre de recherche par email -->
        <input type="text" id="searchInput" style="margin-bottom:10px" class="form-control" placeholder="Rechercher par email utilisateur...">

        <!-- 🔽 Filtrage par statut -->
        <select id="statusFilter" class="form-control">
            <option value="">Tous les statuts</option>
            <option value="En attente">En attente</option>
            <option value="En cours">En cours</option>
            <option value="Résolue">Résolue</option>
        </select>
    </div>

    <table class="table table-striped table-bordered text-center" style="font-size: 14px;">
        <thead class="table-dark" style="font-size: 14px;">
            <tr>
                <th>User Email</th>
                <th>Objet</th>
                <th>Description</th>
                <th>Status</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="reclamationsTable">
            {% for reclamation in reclamations %}
                <tr>
                    <td class="user-email">{{ reclamation.userEmail }}</td>
                    <td>{{ reclamation.objet }}</td>
                    <td>{{ reclamation.description }}</td>
                    <td class="status">
                        {% if reclamation.status == 'En attente' %}
                            <span class="badge bg-warning text-dark" style="font-size: 12px;">En attente</span>
                        {% elseif reclamation.status == 'En cours' %}
                            <span class="badge bg-primary" style="font-size: 12px;">En cours</span>
                        {% else %}
                            <span class="badge bg-success" style="font-size: 12px;">Résolue</span>
                        {% endif %}
                    </td>
                    <td>{{ reclamation.dateSoumission|date('d/m/Y H:i') }}</td>
                    <td class="d-flex justify-content-center gap-1">
                        <a href="{{ path('app_reclamation_front_show', {'id': reclamation.id}) }}" class="btn btn-info btn-sm" style="font-size: 12px;">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a href="{{ path('app_reponsereclamation_new', {'reclamationId': reclamation.id}) }}" class="btn btn-success btn-sm" style="font-size: 12px;">
                            <i class="fas fa-reply"></i>
                        </a>
                        <form action="{{ path('app_reclamation_delete_back', {'id': reclamation.id}) }}" method="post" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.id) }}">
                            <button type="submit" class="btn btn-danger btn-sm" style="font-size: 12px;" onclick="return confirm('Are you sure?');">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted">Aucune réclamation trouvée</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

     <div class="container mt-5">
    <h1 class="text-center" style="font-size: 32px;">Statistiques des Réclamations</h1>
    
    <div class="card p-4 shadow">
        <div class="chart-container" style="display: flex; justify-content: center; align-items: center;">
            <canvas id="reclamationChart" style="max-width: 450px; max-height: 450px;"></canvas>
        </div>
    </div>
</div>


    <!-- 🔹 Script JavaScript pour le filtrage dynamique -->
    <script>
     
        document.getElementById("searchInput").addEventListener("keyup", filterTable);
        document.getElementById("statusFilter").addEventListener("change", filterTable);

        function filterTable() {
            let emailFilter = document.getElementById("searchInput").value.toLowerCase();
            let statusFilter = document.getElementById("statusFilter").value.toLowerCase();
            let rows = document.querySelectorAll("#reclamationsTable tr");

            rows.forEach(row => {
                let email = row.querySelector(".user-email").textContent.toLowerCase();
                let status = row.querySelector(".status").textContent.toLowerCase();
                
                let emailMatch = email.includes(emailFilter);
                let statusMatch = status.includes(statusFilter) || statusFilter === "";

                if (emailMatch && statusMatch) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

   

       document.addEventListener("DOMContentLoaded", function () {
        var ctx = document.getElementById('reclamationChart').getContext('2d');

        var data = [
            {{ stats['En attente'] }},
            {{ stats['En cours'] }},
            {{ stats['Résolue'] }}
        ];

        var total = data.reduce((a, b) => a + b, 0); // 🔹 Calcul du total pour les pourcentages

        var reclamationChart = new Chart(ctx, {
            type: 'pie',
            data: {
                labels: ['En attente', 'En cours', 'Résolue'],
                datasets: [{
                    data: data,
                    backgroundColor: ['#f1c40f', '#3498db', '#2ecc71'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'top',
                    },
                    title: {
                        display: true,
                        text: 'Répartition des Réclamations par Statut'
                    },
                    datalabels: { // 🔹 Ajoute les pourcentages
                        color: '#fff',
                        font: {
                            weight: 'bold',
                            size: 14
                        },
                        formatter: (value) => {
                            return total > 0 ? Math.round((value / total) * 100) + '%' : '0%';
                        }
                    }
                }
            },
            plugins: [ChartDataLabels] // 🔹 Active le plugin Data Labels
        });
    });


     document.getElementById("searchInput").addEventListener("keyup", filterTable);
    document.getElementById("statusFilter").addEventListener("change", filterTable);
    document.getElementById("sortByDate").addEventListener("change", sortTableByDate);

    function filterTable() {
        let emailFilter = document.getElementById("searchInput").value.toLowerCase();
        let statusFilter = document.getElementById("statusFilter").value.toLowerCase();
        let rows = document.querySelectorAll("#reclamationsTable tr");

        rows.forEach(row => {
            let email = row.querySelector(".user-email").textContent.toLowerCase();
            let status = row.querySelector(".status").textContent.toLowerCase();
            
            let emailMatch = email.includes(emailFilter);
            let statusMatch = status.includes(statusFilter) || statusFilter === "";

            if (emailMatch && statusMatch) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }

    
    
    let originalRows = []; // Stocker l'ordre initial des lignes

document.addEventListener("DOMContentLoaded", function () {
    let table = document.getElementById("reclamationsTable");
    originalRows = Array.from(table.querySelectorAll("tr")); // Sauvegarde de l'ordre initial
});

function sortTableByDate() {
    let table = document.getElementById("reclamationsTable");
    let rows = Array.from(table.querySelectorAll("tr"));
    let checkbox = document.getElementById("sortByDate");

    if (!checkbox.checked) {
        // 🟢 Si la case est décochée, restaurer l'ordre initial
        originalRows.forEach(row => table.appendChild(row));
        return;
    }

    rows.sort((a, b) => {
        let dateA = a.cells[4].textContent.trim().split(' '); // Séparer Date et Heure
        let dateB = b.cells[4].textContent.trim().split(' ');

        let datePartA = dateA[0].split('/'); // Format JJ/MM/AAAA
        let datePartB = dateB[0].split('/');

        let timestampA = new Date(`${datePartA[2]}-${datePartA[1]}-${datePartA[0]} ${dateA[1]}`).getTime();
        let timestampB = new Date(`${datePartB[2]}-${datePartB[1]}-${datePartB[0]} ${dateB[1]}`).getTime();

        return timestampB - timestampA; // Tri DESC (du plus récent au plus ancien)
    });

    rows.forEach(row => table.appendChild(row));
}


    </script>
{% endblock %}
