{% extends 'base.html.twig' %}

{% block title %}Conversation{% endblock %}

{% block content %}
<h2>Conversation avec {{ conversation.getParticipants|join(', ') }}</h2>
<ul>
    {% for message in messages %}
        <li>
            <strong>{{ message.user.username }} :</strong> {{ message.content }}
            <span class="text-muted">({{ message.createdAt|date('H:i') }})</span>
        </li>
    {% endfor %}
</ul>

<form method="post">
    <input type="text" name="content" placeholder="Écrire un message..." class="form-control" required>
    <button type="submit" class="btn btn-primary mt-2">Envoyer</button>
</form>

<a href="{{ path('app_conversation_new') }}" class="btn btn-secondary mt-3">Nouvelle conversation</a>
{% endblock %}
