{% extends 'base_front.html.twig' %}

{% block title %}Messages entre {{ conversation.user1.nom }} & {{ conversation.user2.nom }}{% endblock %}

{% block hero %}{% endblock %}
{% block call_to_action %}{% endblock %}
{% block appointment %}{% endblock %}
{% block testimonial %}{% endblock %}
{% block team %}{% endblock %}
{% block classes %}{% endblock %}
{% block about %}{% endblock %}

{% block content %}
<div class="container mt-5">
    <!-- Page Header -->
    <div class="container-xxl py-5 page-header position-relative mb-5">
        <div class="container py-5 text-center">
            <h1 class="display-4 text-white animated slideInDown mb-4">💬 Conversation</h1>
        </div>
    </div>

    <!-- Chat Section -->
    <div class="chat-container mx-auto">
        <div class="chat-header text-center">
            <h2 class="fw-bold text-orange">💬 Chat avec {{ conversation.user1.nom }} & {{ conversation.user2.nom }}</h2>
        </div>

        <!-- Chat Messages -->
        <div class="chat-box" id="chatMessages">
            {% for message in messages %}
                <div class="message {% if message.sender.nom == app.user.nom %} sent {% else %} received {% endif %} fade-in">
                    <div class="message-header d-flex align-items-center">
                        <img src="{{ message.sender.avatar ?? '/images/default-avatar.png' }}" class="avatar">
                        <strong class="user-name">{{ message.sender.nom }}</strong>

                        {% if message.sender.nom == app.user.nom %}
                            <!-- Edit Icon -->
                            <span class="edit-icon ms-auto" onclick="editMessage('{{ message.id }}')">✏️</span>
                            <!-- Delete Icon -->
                            <span class="delete-icon ms-2" onclick="confirmDelete('{{ message.id }}')">🗑️</span>
                        {% endif %}
                    </div>

                    <!-- Message Content -->
                    <p class="message-text" id="message-text-{{ message.id }}">{{ message.content }}</p>

                    <!-- Edit Form -->
                  <form id="edit-form-{{ message.id }}" method="post" action="{{ path('app_message_edit', { id: message.id }) }}" class="edit-form" style="display: none;">
    <input type="hidden" name="_token" value="{{ csrf_token('edit' ~ message.id) }}">
    {{ form_widget(edit_form[message.id].content, {'attr': {'class': 'form-control'}}) }}
    <div class="d-flex mt-2">
        <button type="submit" class="btn btn-sm btn-success">✔️</button>
        <button type="button" class="btn btn-sm btn-danger ms-2" onclick="cancelEdit('{{ message.id }}')">❌</button>
    </div>
</form>


                    <!-- Delete Form (Hidden) -->
                    <form id="delete-form-{{ message.id }}" method="post" action="{{ path('app_message_delete', { id: message.id }) }}" style="display: none;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ message.id) }}">
</form>



                    <span class="message-time">{{ message.createdAt|date('H:i') }}</span>
                </div>
            {% else %}
                <p class="text-center text-muted">Aucun message trouvé.</p>
            {% endfor %}
        </div>

        <!-- New Message Form -->
        <div class="message-form mx-auto mt-3">
            {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                <div class="input-group new-message-box">
                    {{ form_widget(form.content, {'attr': {'class': 'form-control', 'placeholder': 'Tapez votre message...'}}) }}
                    <button type="submit" class="send-button"><i class="fas fa-paper-plane"></i></button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>

<!-- Styles -->
<style>
    .text-orange { color: #ff6f00 !important; }
    .bg-orange { background: #ff6f00 !important; }

    .chat-container {
        max-width: 900px;
        background: #fff;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }

    .chat-box {
        width: 100%;
        height: 500px;
        overflow-y: auto;
        padding: 15px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        background: rgb(251, 251, 251);
        border-radius: 10px;
    }

    .message {
        display: flex;
        flex-direction: column;
        max-width: 65%;
        padding: 12px 15px;
        border-radius: 20px;
        font-size: 16px;
        line-height: 1.5;
        word-wrap: break-word;
        overflow-wrap: break-word;
        white-space: pre-wrap;
        box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease-in-out;
    }

    .sent { background: #ff9800; color: white; align-self: flex-end; border-radius: 20px 20px 0 20px; }
    .received { background: #ffe0b2; color: black; align-self: flex-start; border-radius: 20px 20px 20px 0; }

    .message-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 5px;
    }

    .avatar { width: 35px; height: 35px; border-radius: 50%; object-fit: cover; }
    .user-name { font-weight: bold; flex-grow: 1; }

    .message-time { font-size: 12px; text-align: right; color: #6c757d; margin-top: 5px; }

    .edit-icon, .delete-icon {
        cursor: pointer;
        font-size: 16px;
        background: none;
        border: none;
        transition: color 0.3s;
    }

    .edit-icon { color: #ff6f00; }
    .edit-icon:hover { color: #d45500; }

    .delete-icon { color: red; }
    .delete-icon:hover { color: darkred; }

    .edit-form { display: none; margin-top: 5px; }

    .new-message-box {
        display: flex;
        width: 100%;
        background: #ffffff;
        border-radius: 50px;
        padding: 10px 15px;
        border: 1px solid #ff9800;
        align-items: center;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    }

    .send-button {
        background: #ff6f00;
        border: none;
        color: white;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.3s;
    }

    .send-button:hover { background: #e65c00; }
</style>

<!-- JavaScript -->
<script>
    function editMessage(messageId) {
        document.getElementById("message-text-" + messageId).style.display = "none";
        document.getElementById("edit-form-" + messageId).style.display = "block";
    }

    function cancelEdit(messageId) {
        document.getElementById("message-text-" + messageId).style.display = "block";
        document.getElementById("edit-form-" + messageId).style.display = "none";
    }

    function confirmDelete(messageId) {
        if (confirm("Êtes-vous sûr de vouloir supprimer ce message ?")) {
            document.getElementById("delete-form-" + messageId).submit();
        }
    }
</script>

{% endblock %} 
