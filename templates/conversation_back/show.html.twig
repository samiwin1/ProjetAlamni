{% extends 'base_back.html.twig' %}

{% block title %}📩 Mes Conversations{% endblock %}

{% block welc %}
<div class="container mt-4">
    <h2>💬 Boîte de Discussions</h2>

    <!-- Flash Messages -->
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('info') %}
        <div class="alert alert-info">{{ message }}</div>
    {% endfor %}

    <!-- Conversations List -->
    {% if conversations is not empty %}
        <div class="card shadow-sm p-3 border-0">
            {% for conversation in conversations %}
                <div class="card conversation-item p-3 border-0 bg-light rounded shadow-sm">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <a href="{{ path('app_message_show1', { id: conversation.id }) }}" class="text-dark fw-bold text-decoration-none">
                                📩 {{ conversation.user1.nom }} - {{ conversation.user2.nom }}
                            </a>
                        </div>
                        <form method="post" action="{{ path('conversation_delete', { id: conversation.id }) }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ conversation.id) }}">
                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="event.stopPropagation();">🗑️</button>
                        </form>
                    </div>

                    <!-- Show Input Only If User is in the Conversation -->
                    {% if currentUser.id == conversation.user1.id or currentUser.id == conversation.user2.id %}
                        <div class="mt-3">
                            <form method="post" action="{{ path('app_message_send', { id: conversation.id }) }}">
                                <div class="mb-2">
                                    <textarea name="message" class="form-control" rows="2" placeholder="💬 Envoyez un message..." required></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm">📨 Envoyer</button>
                            </form>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p class="text-muted text-center mt-4">Aucune conversation trouvée.</p>
    {% endif %}
</div>

<style>
    .card {
        border-radius: 12px;
        background: #ffffff;
    }
    textarea {
        border-radius: 6px;
    }
</style>
{% endblock %}
