{% extends 'base_back.html.twig' %}

{% block title %}Planning Index{% endblock %}
{% block navbar %}{% endblock %}

{% block welc %}
    <div class="container">
        <h1 class="mb-4">Planning Index</h1>

        <!-- Action Buttons -->
        <div class="mt-4">
            <!-- Add the "Download PDF" button -->
<a href="{{ path('planning_pdf') }}" class="btn btn-info">Download PDF</a>
            <a href="{{ path('app_planning_new') }}" class="btn btn-primary">Create New Planning</a>
            <a href="{{ path('app_seance_new') }}" class="btn btn-success">Add Seance</a>
        </div>

        <!-- Display the table of existing plannings -->
        <table class="table table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Seance</th>
                    <th>Teacher</th> <!-- New column for teacher name -->
                    <th>Student Level</th> <!-- New column for student level -->
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Uploaded Date</th>
                    <th>Modified Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for planning in plannings %}
                    <tr>
                        <td>{{ planning.id }}</td>
                        <td>{{ planning.name }}</td>
                        <td>{{ planning.seance ? planning.seance.name : 'No Seance' }}</td>
                        <td>{{ planning.teacher ? planning.teacher.getNom() ~ ' ' ~ planning.teacher.getPrenom() : 'No Teacher' }}</td> <!-- Display teacher name -->
                        <td>{{ planning.studentLevel ? planning.studentLevel : 'No Level' }}</td> <!-- Display student level -->
                        <td>{{ planning.startTime ? planning.startTime|date('Y-m-d H:i:s') : '' }}</td>
                        <td>{{ planning.endTime ? planning.endTime|date('Y-m-d H:i:s') : '' }}</td>
                        <td>{{ planning.uploadedDate ? planning.uploadedDate|date('Y-m-d H:i:s') : '' }}</td>
                        <td>{{ planning.modifiedDate ? planning.modifiedDate|date('Y-m-d H:i:s') : '' }}</td>
                        <td class="actions">
                            <a href="{{ path('app_planning_edit', {'id': planning.id}) }}" class="btn btn-warning btn-sm">Edit</a>
                            <form action="{{ path('app_planning_delete', {'id': planning.id}) }}" method="post" class="d-inline">
                                <input type="hidden" name="_method" value="DELETE">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ planning.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this item?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="10" class="text-center text-muted">No records found</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Optional: Add some custom styles -->
    <style>
        .table th, .table td {
            vertical-align: middle;
        }
        .actions {
            white-space: nowrap;
        }
        .no-records {
            text-align: center;
            color: #6c757d;
        }
    </style>
{% endblock %}