{% extends 'base_front.html.twig' %}

{% block title %}Mes Événements Favoris{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="mb-4">Mes Événements Favoris</h1>
    <div class="row">
        {% for event in favorites %}
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card">
                    <img src="{{ asset(event.image) }}" class="card-img-top" alt="{{ event.nom }}">
                    <div class="card-body">
                        <h5 class="card-title">{{ event.nom }}</h5>
                        <a href="{{ path('app_event1_show', {'id': event.id}) }}" class="btn btn-primary">Voir Détails</a>
                    </div>
                </div>
            </div>
        {% else %}
            <p class="text-center">Vous n'avez aucun événement favori.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
